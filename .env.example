# OpenAI-compatible gateway root URL. The CLI uses /v1/chat/completions.
GOGO_MODEL_BASE_URL=
# HTTP GoGo 主模型；对齐 Java 可填 qwen3.7-max；001 CLI 也读取此项。
GOGO_MODEL_NAME=
GOGO_MODEL_API_KEY=

# 026: HTTP 意图改写/L3 与 InfoAgent 共用稳定档；不填写时默认 glm-5.2。
GOGO_STABLE_MODEL_NAME=deepseek-v4-flash-0731
GOGO_RECOMMENDATION_MODEL_NAME=deepseek-v4-flash-0731

# 024 Agent runtime settings; the default Master/Info limits match Java 15/5.
GOGO_MASTER_MAX_ITERS=15
GOGO_INFO_MAX_ITERS=5
GOGO_MANAGE_MAX_ITERS=10
GOGO_INFO_TOOL_TIMEOUT_SECONDS=60
GOGO_MANAGE_TOOL_TIMEOUT_SECONDS=60
GOGO_AGENT_MODEL_TIMEOUT_SECONDS=60
GOGO_POLICY_CORPUS_PATH=

# Intent L2 embedding reuses GOGO_MODEL_API_KEY and GOGO_MODEL_BASE_URL above.
GOGO_INTENT_EMBEDDING_MODEL=qwen3.7-text-embedding
GOGO_INTENT_EMBEDDING_DIMENSIONS=1024
GOGO_INTENT_QDRANT_URL=http://127.0.0.1:6333
GOGO_INTENT_INDEX_VERSION=1
GOGO_INTENT_TOP_K=2
GOGO_INTENT_SCORE_THRESHOLD=0.75
GOGO_INTENT_AMBIGUITY_MARGIN=0.05
GOGO_INTENT_HIGH_CONFIDENCE_THRESHOLD=0.85

# Database connection URL (MariaDB / MySQL)
GOGO_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/gogo_travel?charset=utf8mb4

# Redis session and token store configuration (30 days TTL = 2592000s)
GOGO_REDIS_HOST=127.0.0.1
GOGO_REDIS_PORT=6379
GOGO_REDIS_DB=0
GOGO_REDIS_PASSWORD=
GOGO_AUTH_TOKEN_TTL_SECONDS=2592000

# 085 本机长期偏好 SQLite（默认 ~/.gogo-agent/preferences.sqlite3；不使用共享业务库）
GOGO_PREFERENCE_DB=

# 可选：长期记忆使用的 ReMe HTTP 服务地址。语义召回只读；对话回复保存后由轻量模型抽取
# 本人事实并写入 digest/users/<hash>/ 前缀，失败时只记录日志，不影响对话。
# 地址必须带 http:// 或 https://；留空即关闭长期记忆。
# 启用示例：GOGO_REME_BASE_URL=http://127.0.0.1:2333
GOGO_REME_BASE_URL=
